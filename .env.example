# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# SESSION_SECRET: Signs auth tokens AND customer widget tickets.
# REQUIRED in production (min 32 random chars). Dev warns and uses a fallback.
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=""

# VAULT_ENC_KEY: AES-256-GCM key for stored AI provider keys.
# REQUIRED in production (32 chars). Dev warns and uses a fallback.
VAULT_ENC_KEY=""

# APP_URL: The URL where this app is hosted (e.g., https://your-app.vercel.app).
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# LIBSQL_URL / LIBSQL_AUTH_TOKEN: Turso (or any libSQL server) connection.
# REQUIRED in production on Vercel — the local file DB is ephemeral on serverless.
# Local dev: leave unset to use ./data/app.db automatically.
# Turso example: LIBSQL_URL="libsql://your-db.turso.io" + auth token from `turso db tokens create`.
LIBSQL_URL=""
LIBSQL_AUTH_TOKEN=""
